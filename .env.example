# Configure production values as secret environment variables in Sites.
# Never commit actual values. Local cloud runtime requires macOS 13.5+ or Linux.
GATHER_ENCRYPTION_KEY=
GATHER_OWNER_EMAIL=
GATHER_ORIGIN=
GROQ_API_KEY=
# Leave off until Groq free-account search and citation provenance are verified.
GROQ_WEB_SEARCH_ENABLED=
# Set only after validating owner-private Sites service access and scheduling the writer.
# Disable before changing the Site audience. See README, Automatic Gmail checks.
GMAIL_BACKGROUND_MODE=
