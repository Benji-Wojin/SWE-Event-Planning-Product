# Server-only values. Configure separately for Vercel Preview and Production.
# Never commit actual values. Do not point a preview at production storage.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional until private file storage is provisioned; never use a public Blob store.
# Connected Vercel stores use this ID with fresh, platform-managed OIDC credentials.
BLOB_STORE_ID=
# Alternative for non-Vercel development; takes precedence if both are set.
BLOB_READ_WRITE_TOKEN=
GATHER_ENCRYPTION_KEY=
GATHER_OWNER_EMAIL=
GATHER_ORIGIN=
# Enable only in the intended environment. Existing accounts and the app owner retain access.
# Active, unexpired invitations from GATHER_OWNER_EMAIL also admit their exact recipient.
# Other organizers' invitations do not grant beta access. Manage pending invites in Team access.
WEFT_PRIVATE_BETA=false
# Server-only exact email addresses separated by commas; never commit the real list.
# Once a tester creates an account, removing them here does not revoke that account.
WEFT_BETA_EMAILS=
GROQ_API_KEY=
# Leave off until Groq free-account search and citation provenance are verified.
GROQ_WEB_SEARCH_ENABLED=
# Transactional invitations. Verify the sending domain before deploying.
# No Gmail permission or user-provided credentials are needed.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Gmail is disabled in code on this branch; environment flags cannot enable it.
