# Server-only values. Configure separately for Vercel Preview and Production.
# Never commit actual values. Do not point a preview at production storage.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional until private file storage is provisioned; never use a public Blob store.
BLOB_READ_WRITE_TOKEN=
GATHER_ENCRYPTION_KEY=
GATHER_OWNER_EMAIL=
GATHER_ORIGIN=
GROQ_API_KEY=
# Leave off until Groq free-account search and citation provenance are verified.
GROQ_WEB_SEARCH_ENABLED=
# Leave disabled until mailbox consent and an authenticated schedule are verified.
# To enable: GMAIL_BACKGROUND_MODE=vercel-cron and CRON_SECRET=32+ random chars.
GMAIL_BACKGROUND_MODE=
CRON_SECRET=
